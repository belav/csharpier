try{Get-Item}catch{Write-Host "failed"}
Try
{
    Get-Item
}
Catch [System.IO.IOException],[System.ArgumentException]
{
    Write-Host "io"
}
Catch
{
    Write-Host "other"
}
Finally
{
    Write-Host "done"
}
try { } finally { }
try { } catch { }
try {
    Get-Item
} # after try
catch {
    throw
}
# before finally
finally {
    Write-Host "done"
}
try {
    Get-Item
} catch [System.Exception] # after type
{
    throw
}
