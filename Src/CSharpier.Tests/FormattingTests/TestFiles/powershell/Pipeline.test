Get-ChildItem|Where-Object {$_.Length -gt 5}|Sort-Object Name
Get-ChildItem -Path $somePath -Recurse -Filter "*.ps1" | Where-Object { $_.Length -gt 5 -and $_.Name -like "*test*" } | Sort-Object Name | Select-Object -First 10
