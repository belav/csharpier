Where-Object CPU |
  Sort-Object CPU
Get-Process
    | Where-Object CPU
    | Sort-Object CPU
$items = Get-ChildItem -Path $somePath -Recurse -Filter "*.ps1" | Where-Object { $_.Length -gt 5 } | Sort-Object Name
$items | ForEach-Object {
    $_.Name
    $_.Length
} | Sort-Object
$items | ForEach-Object { $_.Name; $_.Length } | Sort-Object
Get-ChildItem | # get the items
    Sort-Object |
    # leading comment
    Select-Object -First 1
