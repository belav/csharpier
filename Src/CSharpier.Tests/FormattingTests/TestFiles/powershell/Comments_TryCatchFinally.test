try {
    $x = 1
} # after try
catch {
    $x = 2
}

try {
    $x = 1
} catch {
    $x = 2
} # after catch
finally {
    $x = 3
}

try {
    $x = 1
} catch [System.IO.IOException] {
    $x = 2
} # after the first catch
# before the second catch
catch {
    $x = 3
} <# after the second catch #>
finally {
    $x = 4
}

if ($a) {
    $x = 1
} # after if
elseif ($b) {
    $x = 2
} # after elseif
else {
    $x = 3
}

do {
    $x = 1
} # after do
while ($a)

do {
    $x = 1
} # after do
until ($a)
