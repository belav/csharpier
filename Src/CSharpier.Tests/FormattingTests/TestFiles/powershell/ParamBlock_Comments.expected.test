<#
.SYNOPSIS
    help
#>
# before attribute
[CmdletBinding()] # after attribute
param(
    # between

    # the name
    [Parameter(Mandatory)] # after parameter attribute
    # before type
    [string]$Name, # after name

    <# block #> [int]$Count,

    [switch]$Force # last
    # dangling
)

function a {
    param(
        # nothing here
    )
}
function b {
    param(
        $a, # first
        $b
    )
}
