param()

function a {
    param()
}
function b {
    param($a, $b)
}
function c {
    param([string]$Name, [int]$Count = 5)
}
function d {
    param([Parameter(Mandatory)] [string]$Name, [int]$Count = 5)
}
function e {
    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true, Position = 0, ValueFromPipeline = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Name,

        [int]$Count = 5,

        [switch]$Force
    )
}
function f {
    param(
        $a,

        $b,
        $c
    )
}
function g {
    param(
        [Parameter(Mandatory = $true, HelpMessage = "A very long help message that will not fit")]
        [ValidateSet('one', 'two', 'three')]
        [string]$Name
    )
}
function h {
    param([string]$aVeryLongParameterName, [string]$anotherVeryLongParameterName, [string]$third)
}
