using System.Management.Automation.Language;
using CSharpier.Core.DocTypes;

namespace CSharpier.Core.PowerShell.AstPrinters;

internal static class Node
{
    internal static Doc Print(Ast node, PrintContext context)
    {
        if (context.PrintingDepth > 300)
        {
            throw new InTooDeepException();
        }

        context.PrintingDepth++;
        try
        {
            var doc = PrintNode(node, context);
            if (context.HasUnprintedCommentIn(node.Extent))
            {
                doc = Verbatim.PrintNode(node, context);
            }

            return context.WrapWithComments(node, doc);
        }
        finally
        {
            context.PrintingDepth--;
        }
    }

    private static Doc PrintNode(Ast node, PrintContext context)
    {
        return node switch
        {
            {{- for nodeType in NodeTypes }}
            {{ nodeType.SyntaxNodeName }} {{ nodeType.VariableName }} => {{ nodeType.PrinterName }}.Print({{ nodeType.VariableName }}, context),
            {{- end }}
            _ => Verbatim.Print(node.Extent, context),
        };
    }
}

