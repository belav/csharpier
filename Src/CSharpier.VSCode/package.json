{
    "name": "csharpier-vscode",
    "displayName": "CSharpier - Code formatter",
    "description": "Code formatter using csharpier",
    "version": "11.0.0",
    "publisher": "csharpier",
    "qna": "https://github.com/belav/csharpier/issues",
    "author": "CSharpier",
    "homepage": "https://marketplace.visualstudio.com/items?itemName=csharpier.csharpier-vscode",
    "repository": {
        "type": "git",
        "url": "https://github.com/belav/csharpier.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/belav/csharpier/issues"
    },
    "engines": {
        "vscode": "^1.60.0"
    },
    "keywords": [
        "prettier",
        "formatter",
        "c#",
        "csharp",
        "csharpier"
    ],
    "categories": [
        "Formatters"
    ],
    "activationEvents": [
        "onLanguage:csharp",
        "onLanguage:xml"
    ],
    "icon": "logo.png",
    "main": "./build/Extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "This extension is only supported in trusted workspaces"
        }
    },
    "contributes": {
        "configuration": [
            {
                "title": "CSharpier",
                "properties": {
                    "csharpier.enableDebugLogs": {
                        "type": "boolean",
                        "default": false,
                        "description": "Enable debug logs."
                    },
                    "csharpier.dev.customPath": {
                        "title": "blah",
                        "type": "string",
                        "default": "",
                        "description": "Path to directory containing dotnet-csharpier - used for testing the extension with new versions of csharpier."
                    },
                    "csharpier.dev.useCustomPath": {
                        "type": "boolean",
                        "default": false,
                        "description": "Path to directory containing dotnet-csharpier - used for testing the extension with new versions of csharpier."
                    },
                    "csharpier.dev.disableCSharpierServer": {
                        "type": "boolean",
                        "default": false,
                        "description": "Disable CSharpier Server."
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "npm run check-types && node esbuild.js --production",
        "check-types": "tsc --noEmit",
        "start": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "prettier": "prettier ./**/*.{ts,js} --write",
        "vsix": "vsce package"
    },
    "devDependencies": {
        "@types/glob": "7.1.4",
        "@types/mocha": "9.0.0",
        "@types/node": "14.x",
        "@types/node-fetch": "2.6.11",
        "@types/semver": "7.3.9",
        "@types/vscode": "1.60.0",
        "@vscode/vsce": "3.9.2",
        "esbuild": "0.28.1",
        "npm-run-all": "4.1.5",
        "prettier": "2.4.1",
        "semver": "7.6.0",
        "typescript": "5.9.3",
        "xml-js": "1.6.11"
    },
    "dependencies": {
        "node-fetch": "^2.7.0"
    },
    "volta": {
        "node": "22.13.0"
    }
}
